                    "sha512": "8c01959fb1354304dff9e6c903fd7bbff482c27ae277fa580adbdbc4d738298ae59d300e594bdc4e007410af499d8b4434005b9c4bd9603ac1e195f72c5e8593"
                }
            ]
        }
    ]
}
